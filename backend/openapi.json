{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "One field-level validation error of a ``422`` response.\n\nAttributes:\n    location: ``body``, ``query``, ``path``, ``header`` or ``cookie``.\n    field: Dot-joined camelCase field path; ``\"\"`` for the whole location.\n    code: The Pydantic error type, e.g. ``missing``.\n    message: The Pydantic message (English, not localised).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "field",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "The error envelope shared by every ``4xx`` and ``5xx`` response.\n\n``data`` is always ``None``; ``errors`` is a non-empty list only for ``422``\nand ``None`` otherwise.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "title": "Data",
            "type": "null"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId",
          "errors"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthData": {
        "additionalProperties": false,
        "description": "The health payload: exactly ``status`` and ``database``, no deployment details.\n\nAttributes:\n    status: The service can handle requests.\n    database: One query against the database succeeded.",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "HealthDataResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId"
        ],
        "title": "HealthDataResponse",
        "type": "object"
      },
      "HealthStatus": {
        "description": "The only reported state. Adding a value is a breaking change (A10).",
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Label Suite API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Report whether the service and its database are available. Needs no credentials.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDataResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "406": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Acceptable"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Health"
      }
    }
  }
}
