{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "One field-level validation error of a ``422`` response.\n\nAttributes:\n    location: ``body``, ``query``, ``path``, ``header`` or ``cookie``.\n    field: Dot-joined camelCase field path; ``\"\"`` for the whole location.\n    code: The Pydantic error type, e.g. ``missing``.\n    message: The Pydantic message (English, not localised).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "field",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "The error envelope shared by every ``4xx`` and ``5xx`` response.\n\n``data`` is always ``None``; ``errors`` is a non-empty list only for ``422``\nand ``None`` otherwise.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "title": "Data",
            "type": "null"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId",
          "errors"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GoogleAuthorizationData": {
        "additionalProperties": false,
        "description": "The Google authorisation URL the browser navigates to.\n\nAttributes:\n    authorization_url: Includes ``state``, ``nonce``, the S256 PKCE challenge and\n        ``redirect_uri``; the verifier stays in the flow cookie.",
        "properties": {
          "authorizationUrl": {
            "title": "Authorizationurl",
            "type": "string"
          }
        },
        "required": [
          "authorizationUrl"
        ],
        "title": "GoogleAuthorizationData",
        "type": "object"
      },
      "GoogleAuthorizationDataResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/GoogleAuthorizationData"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId"
        ],
        "title": "GoogleAuthorizationDataResponse",
        "type": "object"
      },
      "GoogleSessionRequest": {
        "additionalProperties": false,
        "description": "Completing Google sign-in with what Google sent back to the frontend.\n\nAttributes:\n    code: The authorisation code, passed on as received.\n    state: Must equal the ``state`` in the flow cookie.",
        "properties": {
          "code": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "state": {
            "maxLength": 512,
            "minLength": 1,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "code",
          "state"
        ],
        "title": "GoogleSessionRequest",
        "type": "object"
      },
      "HealthData": {
        "additionalProperties": false,
        "description": "The health payload: exactly ``status`` and ``database``, no deployment details.\n\nAttributes:\n    status: The service can handle requests.\n    database: One query against the database succeeded.",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "HealthDataResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId"
        ],
        "title": "HealthDataResponse",
        "type": "object"
      },
      "HealthStatus": {
        "description": "The only reported state. Adding a value is a breaking change (A10).",
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "LoginOptionsData": {
        "additionalProperties": false,
        "description": "What the sign-in page offers on this deployment.\n\nAttributes:\n    self_registration_enabled: Whether a mail service is configured.\n    google_enabled: Whether all three Google settings are set.",
        "properties": {
          "googleEnabled": {
            "title": "Googleenabled",
            "type": "boolean"
          },
          "selfRegistrationEnabled": {
            "title": "Selfregistrationenabled",
            "type": "boolean"
          }
        },
        "required": [
          "selfRegistrationEnabled",
          "googleEnabled"
        ],
        "title": "LoginOptionsData",
        "type": "object"
      },
      "LoginOptionsDataResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/LoginOptionsData"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId"
        ],
        "title": "LoginOptionsDataResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Email-and-password sign-in.\n\nAttributes:\n    email: 1 to 320 characters once surrounding whitespace is removed; the format\n        is not checked (spec 01-01 §資料欄位).\n    password: 1 to 1024 characters, taken as typed: not trimmed, no composition\n        rule (spec 01-01 Q8).",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "The body of a refresh: always the empty object ``{}``.",
        "properties": {},
        "title": "RefreshRequest",
        "type": "object"
      },
      "SessionData": {
        "additionalProperties": false,
        "description": "``data`` of the sign-in, refresh and current-session responses.",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUserData"
          }
        },
        "required": [
          "user"
        ],
        "title": "SessionData",
        "type": "object"
      },
      "SessionDataResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/SessionData"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "data",
          "timestamp",
          "traceId"
        ],
        "title": "SessionDataResponse",
        "type": "object"
      },
      "SessionUserData": {
        "additionalProperties": false,
        "description": "The signed-in account, as shown by the landing page.\n\nAttributes:\n    id: The account ID.\n    name: The display name.\n    email: The stored, normalised Email.\n    role: The system role read from the database for this request; display only.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "super_admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "title": "SessionUserData",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Label Suite API",
    "version": "0.0.0"
  },
