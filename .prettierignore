# Dependencies and package-manager output
node_modules/
.pnpm-store/
pnpm-lock.yaml

# Backend virtualenv, tool caches and coverage output: listed only in
# backend/.gitignore (and import-linter's own .gitignore in its cache), which
# Prettier does not read (it reads the root .gitignore and this file)
backend/.venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.import_linter_cache/
backend/coverage.json
backend/.coverage*

# Agent worktrees and Playwright MCP scratch output: not this checkout's files
.claude/worktrees/
.playwright-mcp/

# Prototype and design system: left out until a separate issue brings them in
design/

# NoteCraft's ::: directives and {/* @ai-visualize */} markers break under
# Prettier's MDX parser
docs/
.notecraft/

# Generated by tools; do not edit by hand
.claude/skills/
.claude/commands/
.agents/skills/
openspec/schemas/

# Localized copies of notecraftapp's skill-template agents: keep them diffable
# against the template, with its sync markers and list indentation as written
.claude/agents/present-planner.md
.claude/agents/slide-generator.md

# Contains MDX examples; Prettier would rewrite {/* */} as {/_ _/}
AGENTS.md

# Generated by the export command (uv run python -m app.scripts.export_openapi);
# the export command owns its formatting, so Prettier must not rewrite it
backend/openapi.json

# Frontend: Orval owns the generated client (formatting it would make the
# contract drift check fail); build output and coverage reports are local.
# Prettier does not read frontend/.gitignore, so they are listed here.
frontend/src/api/generated/
frontend/dist/
frontend/coverage/
