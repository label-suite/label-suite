# Every setting the orchestration files, the backend, the frontend and the root
# commands read. Copy it once and the Lite tier runs unchanged:
#
#   cp .env.example .env
#   docker compose up --build --wait --wait-timeout 300
#
# .env is ignored by Git and excluded from both images; it is the only place a
# password belongs (AGENTS.md Hard Rule 8). This file holds no usable secret:
# the password field is empty and the connection-string example is commented out
# with placeholders.
#
# The orchestration files require Docker Compose v2.20.0 or newer: older
# versions treat the one-off migrate container, which has already exited
# successfully, as a `docker compose up --wait` failure.

# --- Backend --------------------------------------------------------------
# The allowed browser origins, comma separated; the only required setting. Both
# orchestration files read it with no default, so leaving it unset or empty
# makes Compose refuse to create any container. It must not contain "*", which
# the backend rejects as well (Hard Rule 7). The two values below cover both
# ways of running the app: the local dev server (pnpm run dev, port 5173) and
# the frontend container (FRONTEND_PORT below). Change FRONTEND_PORT and this
# value has to change with it.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Whether CORS responses may carry credentials. The backend defaults to true;
# listed here because both orchestration files pass it through.
CORS_ALLOW_CREDENTIALS=true

# Whether the backend serves its built-in API docs (/docs, /docs/oauth2-redirect,
# /redoc and /openapi.json). The backend defaults to true, which is what the Lite
# tier and a backend run outside a container use. docker-compose.prod.yml pins
# this to false for the production tier, so a value in .env does not change the
# production tier. Uncomment it only to turn the docs off elsewhere.
# API_DOCS_ENABLED=true

# The lowest level the whole backend writes to its log: DEBUG, INFO, WARNING,
# ERROR or CRITICAL, in any case; any other value stops the backend at start-up.
# The backend defaults to INFO. The database engine, connection-pool and driver
# logs do not follow it: they stay at WARNING, so SQL text and parameters never
# reach the log. Both orchestration files pass it to the backend container and
# pass INFO when it is unset. Uncomment it to change the level, for instance to
# WARNING to keep only client and server errors.
# LOG_LEVEL=INFO

# The proxy addresses the backend trusts for X-Forwarded-For and X-Forwarded-Proto,
# a comma-separated list of single IP addresses or CIDR networks. The backend
# defaults to 127.0.0.1,::1 (loopback only), which is what `pnpm run dev` and a
# backend run directly need, so leave it commented out there: scripts/dev.mjs loads
# this file, and a value here would change that default. Both orchestration files
# pass it to the backend container and default it to 10.77.250.10, the address
# they pin for the frontend (Nginx), so the Compose tiers need no value either. Set
# it only when a proxy sits in front of the backend and its address is not that
# one, or when the subnet below has to move. Do not set it when the backend is
# exposed directly: no proxy is in front of it, so nothing should be trusted.
#
# - Never "*" and never a range that covers every address (0.0.0.0/0, ::/0): the
#   backend refuses to start with those, and with hostnames, host bits set in a
#   network, and empty items. The error names this variable and never prints its
#   value.
# - Two ways around that check are not caught and must not be used: overriding the
#   backend `command` with `--forwarded-allow-ips '*'` (the flag beats this
#   variable), and several networks that together cover everything, such as
#   0.0.0.0/1,128.0.0.0/1.
# - The pinned address lives in a fixed subnet, 10.77.250.0/24, in both
#   docker-compose.yml and docker-compose.prod.yml: ip_range 10.77.250.128/25
#   hands out the other containers' addresses and the frontend is pinned at
#   10.77.250.10, outside it. If the subnet overlaps a network or VPN on the host,
#   `docker compose up` fails with a pool overlap; change the three values in both
#   files together and set this variable to the new frontend address.
# - Both tiers share that subnet, so they cannot run on one host at the same time:
#   run `docker compose down` (with -f docker-compose.prod.yml for the production
#   tier) before starting the other one.
# FORWARDED_ALLOW_IPS=10.77.250.10

# Lite tier only: where the database file lives, read by the backend and by the
# migration. Relative paths resolve against the backend's working directory, so
# this default is the file on the named volume inside the container and needs no
# change. Set it only to move the file, for instance when running the backend
# outside a container.
# SQLITE_PATH=./data/label_suite.db

# Production tier for a backend running outside a container: setting this URL
# switches that process to PostgreSQL. Leave it commented out for the Lite tier.
# docker-compose.prod.yml does not read it - that file composes its own URL from
# the three POSTGRES_ variables below. "user:password" is a placeholder, not a
# usable credential.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/label_suite

# --- Sign-in ----------------------------------------------------------------
# The key the backend signs sign-in tokens with, at least 32 characters. Left
# empty on purpose: this file holds no usable secret.
# - Lite tier (no DATABASE_URL): may stay unset. On first start the backend
#   generates one and stores it as auth_secret next to the database file, which
#   in a container is the named data volume; later starts reuse it. Deleting the
#   volume (`docker compose down -v`) or that file signs everyone out.
# - Production tier: required. docker-compose.prod.yml refuses to start without
#   it, and so does a backend with DATABASE_URL set. Generate one, for example
#   with `openssl rand -base64 48`, and keep it out of version control.
AUTH_SECRET=

# Google sign-in. Set all three or none: a partial set stops the backend at
# start-up. When none is set, the sign-in page shows no Google button.
# GOOGLE_REDIRECT_URI is the frontend's callback page as Google calls it, for
# example http://localhost:8080/account/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# The Resend API key for outgoing mail. For now the backend only checks whether
# it is set: when it is, the sign-in page offers self-registration.
RESEND_API_KEY=

# --- Production-tier database (docker-compose.prod.yml) -------------------
# The database role the PostgreSQL container creates and the backend connects as.
POSTGRES_USER=label_suite

# Required by docker-compose.prod.yml and deliberately empty here: the file
# reads it with no default, so the production tier refuses to start until you
# fill it in. Percent-encode any URL reserved character (for example @ : / ? #),
# because the value becomes part of the connection URL.
POSTGRES_PASSWORD=

# The database name the PostgreSQL container creates.
POSTGRES_DB=label_suite

# --- Frontend -------------------------------------------------------------
# Where the local dev server sends API calls. The frontend image is built with
# an empty value instead, because its own nginx serves the API from the same
# origin; the orchestration files set that build argument themselves and do not
# read this one.
VITE_API_BASE_URL=http://localhost:8000

# The host port the frontend container publishes - the only published port of
# either tier, and the address the app is reached at. Keep it in step with
# CORS_ALLOWED_ORIGINS above.
FRONTEND_PORT=8080

# --- Local development ----------------------------------------------------
# The port `pnpm run dev` starts the local backend on. The orchestration files
# ignore it: in a container the backend publishes no host port at all.
BACKEND_PORT=8000

# A local admin for `pnpm run dev`. When all three are filled in, it runs
# `alembic upgrade head` and then creates this Seeder admin (nothing changes if
# it already exists), and reminds you how to sign in. Leave them empty to skip.
# Only `pnpm run dev` reads them: Docker Lite and production do not. The
# password belongs only in your own local .env, which Git ignores.
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_NAME=
DEV_SEED_ADMIN_PASSWORD=
