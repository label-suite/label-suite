node_modules/

# Local settings, copied from .env.example: it holds the database password and
# is read by the orchestration files and the root commands (Hard Rule 8)
.env

# Leftovers of the frontend lint probe tests if interrupted: the layer-boundary
# probes (pages/ and components/) and the size and complexity probes (components/)
frontend/src/pages/**/boundary-probe.tsx
frontend/src/components/boundary-probe.tsx
frontend/src/components/size-probe.tsx
frontend/src/components/size-probe.test.tsx

# Agent worktrees (issue-dispatch creates one per issue)
.claude/worktrees/

# Prototype analytics config holds a real PostHog token
design/prototype/assets/analytics.config.local.json

# Playwright MCP scratch folder (console logs and page snapshots, written on every run)
.playwright-mcp/

# e2e (Playwright) report and per-run output, including the backend SQLite file
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# Backend JUnit reports written by `pnpm run check` and the backend CI jobs
backend/test-results/
